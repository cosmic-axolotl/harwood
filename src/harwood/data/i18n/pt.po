msgstr "dê uma linha para cada quadro, a do primeiro sendo 0 0"

#: harwood/tasks/modern.py:732
msgid "where the frames are against each other"
msgstr "onde os quadros estão uns em relação aos outros"

#: harwood/tasks/modern.py:732
msgid "give --shifts, or --coords with stars seen in all, or --use-wcs"
msgstr "dê --shifts, ou --coords com estrelas vistas em todos, ou --use-wcs"

#: harwood/tasks/modern.py:738
#, python-brace-format
msgid "only {0} stars of {1} are measured in frame {2}"
msgstr "só {0} estrelas de {1} são medidas no quadro {2}"

#: harwood/tasks/modern.py:738
