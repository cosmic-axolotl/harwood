msgstr "Espectros echelle: muitas ordens num só detector."

#: harwood/data/packages.yaml:noao.imred.generic
msgid "Generic reduction steps for data no other package knows."
msgstr "Passos genéricos de redução para dados que nenhum outro pacote conhece."

#: harwood/data/packages.yaml:noao.imred.hydra
msgid "Hydra fibre spectrograph (KPNO/WIYN)."
msgstr "Espectrógrafo de fibras Hydra (KPNO/WIYN)."

#: harwood/data/packages.yaml:noao.imred.iids
msgid "IIDS and IRS spectrographs (historical KPNO)."
msgstr "Espectrógrafos IIDS e IRS (antigos do KPNO)."

#: harwood/data/packages.yaml:noao.imred.irred
