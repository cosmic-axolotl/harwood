#: harwood/tasks/photometry.py:444
#, python-brace-format
msgid "the header has no '{0}'"
msgstr "o cabeçalho não tem '{0}'"

#: harwood/tasks/photometry.py:437
msgid "name the keyword that holds the exposure time, or leave exposure empty and give itime"
msgstr "dê o nome da palavra-chave que guarda o tempo de exposição, ou deixe exposure vazio e dê itime"

#: harwood/tasks/photometry.py:444
#, python-brace-format
