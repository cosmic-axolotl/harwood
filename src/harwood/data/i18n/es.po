msgstr "dé --coords, para construirlas con sus estrellas, o --psf de psfphot --psfout, o --fwhm"

#: harwood/tasks/modern.py:674
#, python-brace-format
msgid "{0} pixels are bad in every frame and are the sky in the coadd."
msgstr "{0} píxeles son malos en todos los cuadros y son el cielo en la suma."

#: harwood/tasks/modern.py:674
msgid "look at where they are before measuring anything near them."
msgstr "mire dónde están antes de medir nada cerca de ellos."

#: harwood/tasks/modern.py:678
#, python-brace-format
msgid "the noise of the coadd is {0}, and it should be {1}"
msgstr "el ruido de la suma es {0}, y debería ser {1}"

#: harwood/tasks/modern.py:678
msgid "a crowded field keeps its faintest stars in the noise; otherwise a wrong PSF or zero point, or frames not on the same pixels, would do this."
msgstr "un campo poblado mantiene sus estrellas más débiles en el ruido; si no, una PSF o un punto cero equivocados, o cuadros que no están en los mismos píxeles, harían esto."

#: harwood/tasks/modern.py:725
#, python-brace-format
msgid "{0} has {1} columns"
msgstr "{0} tiene {1} columnas"

#: harwood/tasks/modern.py:725
