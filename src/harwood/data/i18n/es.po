#: harwood/cli/line.py:60
msgid "a single '&' runs a command in the background, in the cl and in the shell; harwood runs one command at a time"
msgstr "un '&' solo ejecuta un comando en segundo plano, en el cl y en el shell; harwood ejecuta un comando a la vez"

#: harwood/cli/line.py:60
msgid "write '&&' to run the next command only if this one worked, or ';' to run it either way"
msgstr "escriba '&&' para ejecutar el siguiente comando solo si este salió bien, o ';' para ejecutarlo de todos modos"

#: harwood/cli/line.py:65
msgid "harwood does not pipe one command into the next"
msgstr "harwood no encadena la salida de un comando en la entrada del siguiente"

#: harwood/cli/line.py:65
msgid "write '&&' or ';' between commands; to filter what a task prints, run it from the shell: harwood ... | grep ..."
msgstr "escriba '&&' o ';' entre los comandos; para filtrar lo que imprime una tarea, ejecútela desde el shell: harwood ... | grep ..."

