msgstr "vea el manual de splot"

#: harwood/tasks/splot.py:21
msgid "The spectrum as onedspec opens it: a 1-D image's world system, a line of a long slit summed over nsum, a multispec aperture and its dispersion."
msgstr "El espectro como lo abre onedspec: el sistema de coordenadas de una imagen 1-D, una línea de una rendija larga sumada en nsum, una apertura multispec y su dispersión."

#: harwood/tasks/splot.py:21
msgid "Each key's measurement, in real as IRAF computes it: the cursor position, e, k, d, h, m and the rest."
msgstr "La medida de cada tecla, en real como la calcula IRAF: la posición del cursor, e, k, d, h, m y el resto."

#: harwood/tasks/splot.py:21
msgid "The measurements appended to the save_file, with the date and the spectrum's name, as IRAF writes them."
msgstr "Las medidas agregadas al save_file, con la fecha y el nombre del espectro, como las escribe IRAF."

#: harwood/tasks/splot.py:85
msgid "Plot and measure spectra with the cursor's keys."
msgstr "Graficar y medir espectros con las teclas del cursor."

#: harwood/tasks/timeseries.py:107
#, python-brace-format
msgid "{0} errors in {1} are not above zero"
msgstr "{0} errores en {1} no son mayores que cero"

#: harwood/tasks/timeseries.py:107
msgid "a point with no error has infinite weight; leave out --error, or remove them"
msgstr "un punto sin error tiene peso infinito; deje fuera --error, o quítelos"

#: harwood/tasks/timeseries.py:112
#, python-brace-format
msgid "{0} measures in {1}"
msgstr "{0} medidas en {1}"

#: harwood/tasks/timeseries.py:112
msgid "a period needs more than that"
msgstr "un período necesita más que eso"

#: harwood/tasks/timeseries.py:117
#, python-brace-format
msgid "the times in {0} are all the same"
msgstr "los tiempos en {0} son todos iguales"

#: harwood/tasks/timeseries.py:117
