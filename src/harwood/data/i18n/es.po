msgstr "Espectrógrafos IIDS e IRS (históricos de KPNO)."

#: harwood/data/packages.yaml:noao.imred.irred
msgid "Infrared array reduction."
msgstr "Reducción de detectores infrarrojos."

#: harwood/data/packages.yaml:noao.imred.kpnocoude
msgid "KPNO coude spectrograph."
