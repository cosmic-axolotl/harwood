#K DATE       = 2026-10-31              yyyy-mm-dd %-23s     
#K TIME       = 09:25:33                hh:mm:ss   %-23s     
#K PACKAGE    = apphot                  name       %-23s     
#K TASK       = daofind                 name       %-23s     
#
#K SCALE      = 1.                      units      %-23.7g   
#K FWHMPSF    = 3.5                     scaleunit  %-23.7g   
#K EMISSION   = yes                     switch     %-23b     
