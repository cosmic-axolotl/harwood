#!/usr/bin/env python3
"""A stand-in for vi: applies the next edit of $FAKE_EDIT_PLAN to the file -- each a
list of ["replace", old, new] or ["drop", text] for the lines holding text -- and
keeps a copy of what it was given as PLAN.seen<n>."""
import json, os, shutil, sys
plan_path = os.environ["FAKE_EDIT_PLAN"]
plan = json.load(open(plan_path))
counter = plan_path + ".n"
n = int(open(counter).read()) if os.path.exists(counter) else 0
path = sys.argv[-1]
shutil.copy(path, f"{plan_path}.seen{n}")
text = open(path).read()
for step in plan[n] if n < len(plan) else []:
    if step[0] == "replace":
        text = text.replace(step[1], step[2])
    elif step[0] == "drop":
        text = "".join(l for l in text.splitlines(True) if step[1] not in l)
open(path, "w").write(text)
open(counter, "w").write(str(n + 1))
